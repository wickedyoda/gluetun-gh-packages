# Copy this file to .env and edit the values for your VPN provider.

# Container identity
TZ=America/Chicago
PUID=1000
PGID=1000

# Compose host settings
GLUETUN_STATE_DIR=./gluetun
GLUETUN_CONTROL_PORT=8000
GLUETUN_HTTP_PROXY_PORT=8888
GLUETUN_SHADOWSOCKS_PORT=8388

# Required VPN selection
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard

# OpenVPN credentials
OPENVPN_USER=
OPENVPN_PASSWORD=

# WireGuard credentials
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_MTU=1320

# Optional server filtering
SERVER_COUNTRIES=
SERVER_CITIES=
SERVER_HOSTNAMES=

# Allow LAN access through the firewall if needed
FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24

# DNS
DNS_UPSTREAM_RESOLVER_TYPE=DoT
DNS_UPSTREAM_RESOLVERS=
DNS_UPSTREAM_PLAIN_ADDRESSES=
BLOCK_MALICIOUS=on
BLOCK_ADS=off
BLOCK_SURVEILLANCE=off

# Health checks
HEALTH_RESTART_VPN=on
HEALTH_TARGET_ADDRESSES=1.1.1.1:443,8.8.8.8:443
HEALTH_SMALL_CHECK_TYPE=icmp
HEALTH_ICMP_TARGET_IPS=1.1.1.1,8.8.8.8

# Optional built-in services
HTTP_CONTROL_SERVER_LOG=on
HTTPPROXY=off
HTTPPROXY_LOG=off
SHADOWSOCKS=off
SHADOWSOCKS_LOG=off
SHADOWSOCKS_PASSWORD=

# Server data updater
UPDATER_PERIOD=24h
